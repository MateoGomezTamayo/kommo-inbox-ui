# Kommo Integration credentials (Ajustes → Integración → tu app)
KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=
KOMMO_SUBDOMAIN=          # ej: miempresa → miempresa.kommo.com
KOMMO_REDIRECT_URI=https://tu-app.vercel.app/api/auth-callback

# Upstash Redis — se llena automáticamente al conectar Upstash en Vercel dashboard
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
